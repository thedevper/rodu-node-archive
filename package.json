{
  "name": "rodu",
  "private": true,
  "type": "module",
  "description": "Open-source, AI-first, local-first work management: kanban, scrum and knowledge with MCP built in.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "build:web": "pnpm --filter @rodu/web build",
    "test:e2e": "pnpm build:web && pnpm --filter @rodu/web test:e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "rodu": "node apps/cli/src/main.ts",
    "build:binaries": "pnpm build:web && node scripts/build-binaries.ts",
    "smoke:binary": "node scripts/smoke-binary.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
